# ==============================================================================
# Baxtiyor Healthcare Website V2 - Production Environment Configuration
# ==============================================================================

# Canonical Site Domain (Used for canonical URLs, sitemaps, and OpenGraph tags)
NEXT_PUBLIC_SITE_URL=https://baxtiyorhealthcare.com

# Node Environment
NODE_ENV=production

# International Patient WhatsApp Coordination Number (with international country code)
# Example: 919999999999 (Do not include + or hyphens in the raw variable)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Dedicated Emergency / Patient Desk Phone Number (displayed on UI headers)
NEXT_PUBLIC_PHONE_NUMBER=+919999999999

# Google Analytics 4 Measurement ID (Optional - e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (Optional - e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Microsoft Clarity Project ID (Optional - e.g. xxxxxxxxxx)
NEXT_PUBLIC_CLARITY_ID=

# Lead Intake Rate Limiting Configurations (defaults to 10 per 15 min)
RATE_LIMIT_LEADS_PER_WINDOW=10
RATE_LIMIT_UPLOADS_PER_WINDOW=20
RATE_LIMIT_WINDOW_MINUTES=15

