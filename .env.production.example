# ==============================================================================
# Baxtiyor Healthcare Website V2 - Production Environment Configuration
# ==============================================================================

# Canonical Site Domain (Used for canonical URLs, sitemaps, and OpenGraph tags)
NEXT_PUBLIC_SITE_URL=https://baxtiyorhealthcare.com

# Node Environment
NODE_ENV=production

# International Patient WhatsApp Coordination Number (with international country code)
# Example: 919999999999 (Do not include + or hyphens in the raw variable)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Dedicated Emergency / Patient Desk Phone Number (displayed on UI headers)
NEXT_PUBLIC_PHONE_NUMBER=+919999999999

# ==============================================================================
# Firebase Web Configuration (Client-Safe / Public)
# Safe to expose to the browser for Firebase Web SDK & Analytics initialization
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=baxtiyor-healthcare.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=baxtiyor-healthcare
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=baxtiyor-healthcare.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=29655441859
NEXT_PUBLIC_FIREBASE_APP_ID=1:29655441859:web:...
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-G7LBLQQZ2Y

# Google Analytics 4 Measurement ID (Connected to Firebase Analytics)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-G7LBLQQZ2Y

# Google Tag Manager Container ID (Optional - e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Microsoft Clarity Project ID (Optional - e.g. xxxxxxxxxx)
NEXT_PUBLIC_CLARITY_ID=

# ==============================================================================
# Firebase Admin SDK Credentials (SERVER-ONLY / STRICTLY CONFIDENTIAL)
# NEVER prefix with NEXT_PUBLIC_. NEVER commit to Git or expose via client API.
# Used exclusively by server-side Next.js route handlers (/api/leads).
# Provide either JSON string or Base64-encoded Service Account Key:
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternatively, specify path to service account JSON file on server:
GOOGLE_APPLICATION_CREDENTIALS=

# ==============================================================================
# Lead Intake Rate Limiting Configurations (defaults to 10 per 15 min)
# ==============================================================================
RATE_LIMIT_LEADS_PER_WINDOW=10
RATE_LIMIT_UPLOADS_PER_WINDOW=20
RATE_LIMIT_WINDOW_MINUTES=15

# ==============================================================================
# Admin Dashboard Authentication (SERVER-ONLY / TEMPORARY DEVELOPMENT SYSTEM)
# NEVER prefix with NEXT_PUBLIC_. NEVER commit actual values to Git.
# ==============================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
